---
import { href } from '@/lib/content';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}
const { title = 'Quietly — A Journal for Slower Living', description = 'A small journal about slow mornings, travel, craft, and simple homes.', image, type = 'website' } = Astro.props;
const canonical = Astro.url.href;
const ogImage = image ? new URL(image, Astro.url).href : undefined;
const currentPath = Astro.url.pathname;
const rootPath = new URL(href('/'), Astro.url).pathname;
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f6f4ee" />
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={href('/sitemap-index.xml')} />
  <link rel="alternate" type="application/rss+xml" title="Quietly RSS" href={href('/rss.xml')} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <title>{title}</title>
  <script is:inline>
    (() => {
      const saved = localStorage.getItem('theme');
      const theme = saved === 'dark' || saved === 'light' ? saved : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    })();
  </script>
</head>
<body>
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={href('/')} aria-label="Quietly home">
      <span class="brand-mark" aria-hidden="true">✎</span><span>Quietly</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href={href('/')} class:list={{ active: currentPath === rootPath }}>Journal</a>
      <a href={href('/about/')} class:list={{ active: currentPath.includes('/about') }}>About</a>
      <a href={href('/categories/')} class:list={{ active: currentPath.includes('/categories') }}>Categories</a>
    </nav>
    <div class="header-actions">
      <a class="button button-dark" href={href('/journal/')}>Read latest</a>
      <button class="icon-button" id="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle theme">◐</button>
      <details class="mobile-menu">
        <summary class="icon-button" aria-label="Open menu">☰</summary>
        <nav class="mobile-popover" aria-label="Mobile navigation">
          <a href={href('/')}>Journal</a>
          <a href={href('/about/')}>About</a>
          <a href={href('/categories/')}>Categories</a>
          <a href={href('/tags/')}>Tags</a>
          <a href={href('/rss.xml')}>RSS</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<main><slot /></main>

<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="footer-copy">
      <a class="brand" href={href('/')}><span class="brand-mark" aria-hidden="true">✎</span><span>Quietly</span></a>
      <p>A slow journal about mornings, making things by hand, and leaving room for the parts of life that do not fit in a schedule.</p>
    </div>
    <div class="footer-links">
      <a href={href('/about/')}>About</a><a href={href('/categories/')}>Categories</a><a href={href('/tags/')}>Tags</a><a href={href('/rss.xml')}>RSS</a>
    </div>
  </div>
  <div class="shell footer-bottom"><span>© {new Date().getFullYear()} Quietly</span><span>Built with Astro + Vite</span></div>
</footer>
<script is:inline>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
</body>
</html>
