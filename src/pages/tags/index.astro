---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href, slugify, sortPosts, uniqueValues } from '@/lib/content';
const posts = sortPosts(await getCollection('blog'));
const tags = uniqueValues(posts, 'tags');
---
<BaseLayout title="Tags — Quietly" description="Browse Quietly stories by tag.">
<section class="shell page-intro"><p class="section-kicker">Browse</p><h1>Tags</h1><p>Follow a thread across the journal.</p></section>
<section class="shell section-stack compact-section"><div class="tag-cloud">{tags.map((tag) => <a class="filter-pill" href={href(`/tags/${slugify(tag)}/`)}>#{tag}</a>)}</div></section>
</BaseLayout>
