---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { href, slugify, sortPosts, uniqueValues } from '@/lib/content';
const posts = sortPosts(await getCollection('blog'));
const [featured, ...rest] = posts;
const categories = uniqueValues(posts, 'category');
---
<BaseLayout>
<section class="hero shell">
  <span class="eyebrow">A journal for slower living</span>
  <h1>Stories about mornings, making, and paying attention.</h1>
  <p>Quietly is a small journal about slowing down: how we travel, work with our hands, and shape the rooms we live in.</p>
</section>
<section class="shell section-stack" id="latest" aria-labelledby="latest-heading">
  <div class="section-heading"><div><p class="section-kicker">Latest</p><h2 id="latest-heading">Recent stories</h2></div><a class="text-link" href={href('/journal/')}>View all →</a></div>
  {featured && <PostCard post={featured} featured />}
  <div class="post-grid">{rest.map((post) => <PostCard post={post} />)}</div>
</section>
<section class="shell section-stack compact-section" aria-labelledby="categories-heading">
  <div class="section-heading"><div><p class="section-kicker">Browse</p><h2 id="categories-heading">By category</h2></div></div>
  <div class="category-grid">
    {categories.map((category) => <a class="category-card" href={href(`/categories/${slugify(category)}/`)}><span>{category}</span><span aria-hidden="true">↗</span></a>)}
  </div>
</section>
</BaseLayout>
